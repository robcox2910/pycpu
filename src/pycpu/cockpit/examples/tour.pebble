# A tour of everything Pebble can do on PyCPU
fn fact(n) {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}
fn describe(n) {
    if n % 2 == 0 and n >= 2 {
        print("even")
    } else if n == 1 or not (n > 2) {
        print("small")
    } else {
        print("odd")
    }
    return n // 2
}
print("Hello from Pebble!")
let total = 0
for i in range(1, 5) {
    total = total + fact(i)
    describe(i)
}
print(total)
let n = -total
while n < 0 {
    n = n + 10
}
if n != 0 {
    print(n)
}
